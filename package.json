{
  "name": "fg-nexus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint .",
    "lint:eslint": "eslint . --cache",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"vite.config.ts\" \".github/**/*.yml\" \"README.md\" \"package.json\"",
    "lint:fix": "run-s lint:oxlint:fix lint:eslint:fix",
    "lint:oxlint:fix": "oxlint . --fix",
    "lint:eslint:fix": "eslint . --fix --cache",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"vite.config.ts\" \".github/**/*.yml\" \"README.md\" \"package.json\"",
    "test:unit:run": "vitest --run",
    "check": "run-s format:check type-check lint test:unit:run build-only"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "maplibre-gl": "^6.10.0",
    "pinia": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.93.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
